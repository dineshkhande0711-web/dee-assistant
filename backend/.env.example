# AI Provider: "gemini", "anthropic", or "openai"
AI_PROVIDER=gemini

# API Keys (fill in whichever provider you use)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional custom model names:
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OPENAI_MODEL=gpt-4o-mini

# Authentication Tokens for paired phones
MY_PHONE_TOKEN=change-me-1
FRIEND_PHONE_TOKEN=change-me-2
